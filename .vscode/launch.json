{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "cppdbg",
        "request": "launch",
        "name": "Launch eternityII",
        "program": "${workspaceFolder}/eternityII",
        "args": ["test",
            "./pieces.csv"],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": false,
        "preLaunchTask": "build-eternityII"
      },
      {
        "type": "cppdbg",
        "request": "launch",
        "name": "Launch eternityII Server",
        "program": "${workspaceFolder}/eternityIIDebugServer",
        "args": ["tcpserver",
                "80",
                "./pieces.csv"],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "externalConsole": false,
        "preLaunchTask": "build-eternityIIDebugServer",
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb",
        "setupCommands": [
          {
              "description": "Enable funcy printing to gdb",
              "text": "-enable-pretty-printing",
              "ignoreFailures": true
          },
          {   "description":"In this mode GDB will be attached to both processes after a call to fork() or vfork().",
              "text": "-gdb-set detach-on-fork off",
              "ignoreFailures": true
          },
          {   "description": "The new process is debugged after a fork. The parent process runs unimpeded.",
              "text": "-gdb-set follow-fork-mode child",
              "ignoreFailures": true
          }
        ]
      },
      {
        "type": "cppdbg",
        "request": "launch",
        "name": "Launch eternityII Client",
        "program": "${workspaceFolder}/eternityIIDebugClient",
        "args": ["tcpclient",
                "localhost",
                "1",
                "./pieces.csv"],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "externalConsole": false,
        "preLaunchTask": "build-eternityIIDebugClient",
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb",
        "setupCommands": [
          {
              "description": "Enable funcy printing to gdb",
              "text": "-enable-pretty-printing",
              "ignoreFailures": true
          },
          {   "description":"In this mode GDB will be attached to both processes after a call to fork() or vfork().",
              "text": "-gdb-set detach-on-fork off",
              "ignoreFailures": true
          },
          {   "description": "The new process is debugged after a fork. The parent process runs unimpeded.",
              "text": "-gdb-set follow-fork-mode child",
              "ignoreFailures": true
          }
        ]
      },
      {
        "type": "cppdbg",
        "request": "launch",
        "name": "Launch eternityII Client multithread",
        "program": "${workspaceFolder}/eternityIIDebugClient",
        "args": ["tcpclient",
                "localhost",
                "6",
                "./pieces.csv"],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "externalConsole": false,
        "preLaunchTask": "build-eternityIIDebugClient",
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb",
        "setupCommands": [
          {
              "description": "Enable funcy printing to gdb",
              "text": "-enable-pretty-printing",
              "ignoreFailures": true
          },
          {   "description":"In this mode GDB will be attached to both processes after a call to fork() or vfork().",
              "text": "-gdb-set detach-on-fork off",
              "ignoreFailures": true
          },
          {   "description": "The new process is debugged after a fork. The parent process runs unimpeded.",
              "text": "-gdb-set follow-fork-mode child",
              "ignoreFailures": true
          }
        ]
      }
    ]
  }