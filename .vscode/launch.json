{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "cppdbg",
        "request": "launch",
        "name": "Launch eternityII",
        "program": "${workspaceFolder}/eternityII",
        "args": ["test",
            "./pieces.csv"],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": false,
        "preLaunchTask": "build-eternityII"
      },
      {
        "type": "cppdbg",
        "request": "launch",
        "name": "Launch eternityII Server",
        "program": "${workspaceFolder}/eternityIIDebugServer",
        "args": ["tcpserver",
                "80",
                "./pieces.csv"],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "externalConsole": false,
        "preLaunchTask": "build-eternityIIDebugServer",
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb"
      },
      {
        "type": "cppdbg",
        "request": "launch",
        "name": "Launch eternityII Client",
        "program": "${workspaceFolder}/eternityIIDebugClient",
        "args": ["tcpclient",
                "localhost",
                "1",
                "./pieces.csv"],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "externalConsole": false,
        "preLaunchTask": "build-eternityIIDebugClient",
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb"
      },
      {
        "type": "cppdbg",
        "request": "launch",
        "name": "Launch eternityII Client multithread",
        "program": "${workspaceFolder}/eternityIIDebugClient",
        "args": ["tcpclient",
                "localhost",
                "6",
                "./pieces.csv"],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "externalConsole": false,
        "preLaunchTask": "build-eternityIIDebugClient",
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb"
      }
    ]
  }